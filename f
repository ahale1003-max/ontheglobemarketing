                fontSize: "clamp(2.2rem,6vw,4rem)", letterSpacing: "-0.03em", color: "white", lineHeight: 1.08 }}>
                Your brand's best chapter<br />
                <span style={{ background: T.grad, WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip:"text" }}>starts right now.</span>
              </h2>
              <p style={{ color: T.textSec, fontSize: "clamp(1rem,2.5vw,1.15rem)", lineHeight: 1.75, maxWidth: 520, margin: "1.5rem auto 2.5rem" }}>
                We're a new agency with big ambitions, and we'd love for your brand to be one of our founding stories. Drop your email and let's talk about what we can build together.
              </p>
              {status === "success" ? (
                <div style={{ display: "inline-flex", alignItems: "center", gap: 10, padding: "16px 28px", borderRadius: T.radius, background: "rgba(34,197,94,0.12)", border: "1px solid rgba(34,197,94,0.3)", color: "#4ade80", fontSize: 16, fontWeight: 600 }}>
                  ✓ You're in! We'll be in touch within 24 hours.
                </div>
              ) : (
                <form onSubmit={submit}
                  style={{ display: "flex", gap: "0.75rem", maxWidth: 480, margin: "0 auto", flexWrap: "wrap", justifyContent: "center" }}>
                  <input type="email" placeholder="Enter your email" value={email} onChange={e => setEmail(e.target.value)} required
                    style={{ flex: "1 1 220px", minWidth: 0, padding: "14px 18px", borderRadius: T.radiusSm, border: `1px solid ${status === "error" ? "rgba(239,68,68,0.5)" : T.border}`, background: "rgba(255,255,255,0.04)", color: "white", fontSize: 15, outline: "none", transition: "border-color 0.2s", fontFamily: T.font }}
                    onFocus={e => e.target.style.borderColor = "rgba(139,92,246,0.5)"}
                    onBlur={e => e.target.style.borderColor = T.border}
                  />
                  <BtnPrimary size="lg">{status === "sending" ? "Sending…" : "Start Free Consultation"}</BtnPrimary>
                </form>
              )}
              {status === "error" && (
                <p style={{ marginTop: "0.75rem", color: "#fca5a5", fontSize: 13 }}>Submission failed — please try again or email ontheglobemarketing@gmail.com directly.</p>
              )}
              <p style={{ marginTop: "1.2rem", color: T.textMuted, fontSize: 12 }}>
                No commitment required · Free 30-min strategy call · Response within 24 hours
              </p>
            </Reveal>
          </div>
        </section>
      );
    };

    // ── CONTACT ────────────────────────────────────────────────────────────────
    const Contact = () => {
      const [form, setForm]     = useState({ name:"", email:"", message:"" });
      const [status, setStatus] = useState("idle");
      const setF = (k,v) => setForm(f => ({...f,[k]:v}));

      const submit = async (e) => {
        e.preventDefault();
        setStatus("sending");
        try {
          const res = await fetch(`https://formsubmit.co/ajax/${CONTACT_EMAIL}`, {
            method:"POST",
            headers:{"Content-Type":"application/json",Accept:"application/json"},
            body: JSON.stringify({
              _subject:  `✉️ New Contact Message — ${form.name}`,
              _template: "table",
              _replyto:  form.email,
              name:    form.name,
              email:   form.email,
              message: form.message,
            }),
          });
          const data = await res.json();
          if (res.ok && data.success !== "false") { setStatus("success"); setForm({name:"",email:"",message:""}); }
          else setStatus("error");
        } catch { setStatus("error"); }
      };

      const infoCards = [
        { label:"Email",    value:"ontheglobemarketing@gmail.com", sub:"We respond within 24 hours",     action:"mailto:ontheglobemarketing@gmail.com" },
        { label:"Instagram", value:"@ontheglobemarketing",          sub:"DM us anytime",                  action:"https://instagram.com/ontheglobemarketing" },
        { label:"Location", value:"United States",                 sub:"Serving clients everywhere",     action: null },
      ];

      return (
        <section id="contact" style={{
          padding:"clamp(5rem,10vw,9rem) clamp(1.2rem,6vw,4rem)",
          background:"linear-gradient(180deg,#07070f 0%,#0b0b1c 60%,#07070f 100%)",
          position:"relative", overflow:"hidden",
        }}>
          {/* glow */}
          <div style={{ position:"absolute", top:"30%", left:"50%", transform:"translate(-50%,-50%)",
            width:"70vw", maxWidth:800, height:400,
            background:"radial-gradient(ellipse,rgba(99,102,241,0.12) 0%,transparent 70%)",
            filter:"blur(60px)", pointerEvents:"none" }} />

          <div style={{ maxWidth:1100, margin:"0 auto" }}>
            {/* Label */}
            <Reveal>
              <div style={{ display:"flex", alignItems:"center", gap:10, marginBottom:18 }}>
                <div style={{ width:32, height:2, background:"linear-gradient(90deg,#6366f1,#8b5cf6)", borderRadius:2 }} />
                <span style={{ fontSize:11, fontWeight:700, letterSpacing:"0.18em", textTransform:"uppercase",
                  color:"rgba(139,92,246,0.85)" }}>Contact</span>
              </div>
            </Reveal>
            <Reveal delay={0.06}>
              <h2 style={{ fontFamily:"'Syne',sans-serif", fontWeight:800,
                fontSize:"clamp(2rem,5vw,3.4rem)", lineHeight:1.1, letterSpacing:"-0.03em",
                color:"white", maxWidth:600, marginBottom:"clamp(1rem,2.5vw,1.5rem)" }}>
                Let's build something<br />
                <span style={{ background:"linear-gradient(90deg,#818cf8,#a78bfa)",
                  WebkitBackgroundClip:"text", WebkitTextFillColor:"transparent",
                  backgroundClip:"text" }}>great together.</span>
              </h2>
              <p style={{ fontSize:"clamp(1rem,1.5vw,1.1rem)", color:"rgba(240,239,255,0.6)",
                lineHeight:1.7, maxWidth:480, marginBottom:"clamp(2.5rem,5vw,4rem)" }}>
                Whether you have a project in mind or just want to chat about your brand, we'd love to hear from you. Reach out directly or fill in the form.
              </p>
            </Reveal>

            <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit,minmax(min(100%,440px),1fr))",
              gap:"clamp(2rem,5vw,4rem)", alignItems:"start" }}>

              {/* Left — info cards */}
              <Reveal delay={0.1}>
                <div style={{ display:"flex", flexDirection:"column", gap:"1rem" }}>
                  {infoCards.map(c => (
                    <div key={c.label}
                      onClick={() => c.action && window.open(c.action)}
                      style={{
                        display:"flex", alignItems:"flex-start", gap:"1rem",
                        background:"rgba(255,255,255,0.03)",
                        border:`1px solid ${c.action ? "rgba(99,102,241,0.25)" : "rgba(255,255,255,0.08)"}`,
                        borderRadius:16, padding:"1.25rem 1.4rem",
                        backdropFilter:"blur(6px)",
                        cursor: c.action ? "pointer" : "default",
                        transition:"all 0.2s",
                      }}
                      onMouseEnter={e => { if(c.action) { e.currentTarget.style.background="rgba(99,102,241,0.1)"; e.currentTarget.style.borderColor="rgba(99,102,241,0.4)"; }}}
                      onMouseLeave={e => { if(c.action) { e.currentTarget.style.background="rgba(255,255,255,0.03)"; e.currentTarget.style.borderColor="rgba(99,102,241,0.25)"; }}}
                    >
                      <div style={{ flex:1 }}>
                        <div style={{ fontSize:12, fontWeight:700, letterSpacing:"0.08em",
                          textTransform:"uppercase", color:"rgba(139,92,246,0.8)", marginBottom:4 }}>{c.label}</div>
                        <div style={{ fontSize:15, fontWeight:700, color:"white", marginBottom:3 }}>{c.value}</div>
                        <div style={{ fontSize:12, color:"rgba(240,239,255,0.45)", display:"flex", alignItems:"center", gap:6 }}>
                          {c.sub}
                          {c.action && <span style={{ fontSize:11, color:"rgba(139,92,246,0.7)", fontWeight:600 }}>Tap to message →</span>}
                        </div>
                      </div>
                    </div>
                  ))}

                  {/* Social row */}
                  <div style={{ marginTop:"0.4rem" }}>
                    <div style={{ fontSize:12, fontWeight:700, letterSpacing:"0.1em", textTransform:"uppercase",
                      color:"rgba(139,92,246,0.75)", marginBottom:12 }}>Follow Along</div>
                    <div style={{ display:"flex", gap:10, flexWrap:"wrap" }}>
                      {[
                        { label:"Instagram", handle:"@ontheglobemarketing" },
                        { label:"TikTok",    handle:"@ontheglobe" },
                        { label:"LinkedIn",  handle:"On the Globe Marketing" },
                      ].map(s => (
                        <div key={s.label} style={{
                          background:"rgba(99,102,241,0.08)", border:"1px solid rgba(99,102,241,0.2)",
                          borderRadius:100, padding:"6px 14px",
                          fontSize:12, fontWeight:600, color:"rgba(200,200,255,0.8)",
                          cursor:"pointer",
                        }}>{s.label} · {s.handle}</div>
                      ))}
                    </div>
                  </div>
                </div>
              </Reveal>

              {/* Right — contact form */}
              <Reveal delay={0.18}>
                <div style={{
                  background:"rgba(255,255,255,0.03)",
                  border:"1px solid rgba(255,255,255,0.08)",
                  borderRadius:20, padding:"2rem",
                  backdropFilter:"blur(6px)",
                }}>
                  {status === "success" ? (
                    <div style={{ textAlign:"center", padding:"3rem 1rem" }}>
                      <div style={{ fontSize:40, marginBottom:16 }}>🎉</div>
                      <div style={{ fontSize:20, fontWeight:800, color:"white", marginBottom:8 }}>Message sent!</div>
                      <p style={{ color:"rgba(240,239,255,0.6)", lineHeight:1.65 }}>We'll be in touch within 24 hours. Talk soon.</p>
                    </div>
                  ) : (
                    <form onSubmit={submit} style={{ display:"flex", flexDirection:"column", gap:"1rem" }}>
                      <div>
                        <div>
                          <label className="modal-label">Name *</label>
                          <input className="modal-input" required placeholder="Your name"
                            value={form.name} onChange={e=>setF("name",e.target.value)} />
                        </div>

                      </div>
                      <div>
                        <label className="modal-label">Email *</label>
                        <input className="modal-input" type="email" required placeholder="your@email.com"
                          value={form.email} onChange={e=>setF("email",e.target.value)} />
                      </div>
                      <div>
                        <label className="modal-label">How can we help?</label>
                        <textarea className="modal-input modal-textarea" placeholder="Tell us about your project or what you're looking to achieve..."
                          value={form.message} onChange={e=>setF("message",e.target.value)}
                          style={{ minHeight:110 }} />
                      </div>
                      {status === "error" && (
                        <p style={{ color:"#fca5a5", fontSize:13, margin:0 }}>Something went wrong. Please try again or email us at ontheglobemarketing@gmail.com.</p>
                      )}
                      <button type="submit" className="modal-submit"
                        disabled={status==="sending"}
                        style={{ opacity: status==="sending" ? 0.7 : 1, cursor: status==="sending" ? "not-allowed" : "pointer" }}>
                        {status === "sending" ? "Sending your message…" : "Send Message →"}
                      </button>
                      <p style={{ textAlign:"center", fontSize:12, color:"rgba(240,239,255,0.35)", margin:0 }}>
                        Sends directly to ontheglobemarketing@gmail.com
                      </p>
                    </form>
                  )}
                </div>
              </Reveal>
            </div>
          </div>
        </section>
      );
    };

    // ── FOOTER ─────────────────────────────────────────────────────────────────
    const Footer = () => {
      const navCols = [
        {
          heading: "Services",
          items: [
            { label: "Brand Strategy",    href: "#services" },
            { label: "Content Creation",  href: "#services" },
            { label: "Social Media",      href: "#services" },
            { label: "Video Production",  href: "#services" },
          ],
        },
        {
          heading: "Company",
          items: [
            { label: "About Us",   href: "#about" },
            { label: "Our Work",   href: "#work" },
            { label: "Pricing",    href: "#pricing" },
            { label: "Contact",    href: "#contact" },
          ],
        },
      ];
      return (
        <footer style={{ background: "rgba(255,255,255,0.015)", borderTop: `1px solid ${T.border}`, padding: "clamp(3rem,6vw,5rem) clamp(1rem,5vw,3rem) clamp(1.5rem,3vw,2.5rem)" }}>
          <div style={{ maxWidth: 1200, margin: "0 auto" }}>
            <div style={{ display: "grid", gridTemplateColumns: "2fr 1fr 1fr", gap: "3rem", marginBottom: "3rem" }} className="footer-grid">
              {/* Brand col */}
              <div>
                <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: "1.2rem" }}>
                  <GlobeLogo size={36} uid="foot" />
                  <div style={{ lineHeight: 1 }}>
                    <div style={{ color: "white", fontWeight: 800, fontSize: 13, letterSpacing: "-0.3px" }}>
                      On the Globe <span style={{ background: T.grad, WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent" }}>Marketing</span>
                    </div>
                  </div>
                </div>
                <p style={{ color: T.textSec, fontSize: 14, lineHeight: 1.75, maxWidth: 260 }}>A creative marketing agency turning bold ideas into iconic brands, worldwide.</p>
              </div>
              {/* Nav cols */}
              {navCols.map(col => (
                <div key={col.heading}>
                  <div style={{ color: "white", fontWeight: 700, fontSize: 14, marginBottom: "1rem", letterSpacing: "-0.2px" }}>{col.heading}</div>
                  {col.items.map(item => (
                    <a key={item.label} href={item.href}
                      style={{ display: "block", color: T.textSec, textDecoration: "none", fontSize: 14, padding: "4px 0", transition: "color 0.2s" }}
                      onMouseEnter={e => e.target.style.color = "white"}
                      onMouseLeave={e => e.target.style.color = T.textSec}
                    >{item.label}</a>
                  ))}
                </div>
              ))}
            </div>
            <div style={{ borderTop: `1px solid ${T.border}`, paddingTop: "1.5rem", display: "flex", justifyContent: "space-between", alignItems: "center", flexWrap: "wrap", gap: "1rem" }}>
              <p style={{ color: T.textMuted, fontSize: 13 }}>© 2026 On the Globe Marketing. All rights reserved.</p>
              <p style={{ color: T.textMuted, fontSize: 13 }}>Built for brands that dare to be different.</p>
            </div>
          </div>
        </footer>
      );
    };

    // ── APP ────────────────────────────────────────────────────────────────────
    function App() {
      const [bookCallOpen, setBookCallOpen] = useState(false);
      return (
        <div style={{ fontFamily: T.font, background: T.bg, minHeight: "100vh" }}>
          <Navbar onBookCall={() => setBookCallOpen(true)} />
          <Hero onBookCall={() => setBookCallOpen(true)} />
          <Features />
          <About />
          <Testimonials />
          <Quiz />
          <Pricing />
          <FinalCTA />
          <Contact />
          <Footer />
          {bookCallOpen && <BookCallModal onClose={() => setBookCallOpen(false)} />}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById("root")).render(<App />);
  </script>
</body>
</html>
