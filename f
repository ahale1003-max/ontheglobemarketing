    // ── PRICING CAROUSEL — spring-physics merry-go-round ─────────────────────
    const PricingCarousel = ({ plans, defaultActive = 1 }) => {
      const [quoteModal, setQuoteModal] = useState(null); // plan name or null
      const winW = useWindowWidth();

      const N    = plans.length;
      const STEP = 360 / N;   // degrees per card
      const isMobile = winW < 700;
      const isSmall  = winW < 480;
      const RX   = isSmall ? 175 : isMobile ? 225 : 355;  // shrink ellipse on mobile
      const RZ   = isSmall ?  65 : isMobile ?  88 : 155;

      // ── Physics refs (mutated every RAF frame — no re-renders) ────────────
      const targetRef = useRef(-defaultActive * STEP); // where the wheel wants to be
      const curRef    = useRef(-defaultActive * STEP); // current animated angle
      const velRef    = useRef(0);                     // angular velocity (deg/frame)
      const rafRef    = useRef(null);

      // ── Drag refs ─────────────────────────────────────────────────────────
      const grabXRef    = useRef(null);  // clientX at pointer-down
      const grabAngle   = useRef(0);     // curRef value at pointer-down
      const prevXRef    = useRef(null);  // last clientX (for velocity)
      const dragVelRef  = useRef(0);     // smoothed pixel velocity (EMA)

      // ── Render state ──────────────────────────────────────────────────────
      const [dispAngle, setDispAngle] = useState(-defaultActive * STEP);
      const [grabbing,  setGrabbing]  = useState(false);
      const [didDrag,   setDidDrag]   = useState(false);

      // Active card derived from TARGET (shows destination while animating)
      const active = ((Math.round(-targetRef.current / STEP) % N) + N) % N;

      // ── Motion loop ───────────────────────────────────────────────────────
      // Formula: velocity decays (momentum) + lerp pull (never overshoots).
      // This gives an ease-OUT feel: fast start → smooth deceleration → clean settle.
      const DECAY = 0.78;   // how fast velocity bleeds off each frame
      const LERP  = 0.19;   // how strongly each frame pulls toward target

      const startSpring = () => {
        if (rafRef.current) cancelAnimationFrame(rafRef.current);
        const tick = () => {
          velRef.current *= DECAY;
          const diff = targetRef.current - curRef.current;
          curRef.current += velRef.current + diff * LERP;
          setDispAngle(curRef.current);
          if (Math.abs(diff) > 0.05 || Math.abs(velRef.current) > 0.05) {
            rafRef.current = requestAnimationFrame(tick);
          } else {
            curRef.current = targetRef.current;
            setDispAngle(targetRef.current);
            rafRef.current = null;
          }
        };
        rafRef.current = requestAnimationFrame(tick);
      };

      useEffect(() => () => { if (rafRef.current) cancelAnimationFrame(rafRef.current); }, []);

      // Snap to nearest card, seeded with drag momentum.
      // Longer projection (×10) means a moderate flick reliably advances one card.
      const snapNearest = (seedVel = 0) => {
        const projected   = curRef.current + seedVel * 10;
        const steps       = Math.round(-projected / STEP);
        targetRef.current = -steps * STEP;
        velRef.current    = seedVel;
        startSpring();
      };

      const go = (dir) => {
        const steps = Math.round(-targetRef.current / STEP);
        targetRef.current = -(steps + dir) * STEP;
        // Seed with a push in the direction of travel so the card sweeps away
        // immediately instead of slowly accelerating from rest
        velRef.current = -dir * 6;
        startSpring();
      };

      const goTo = (i) => {
        let diff = ((i - active) % N + N) % N;
        if (diff > N / 2) diff -= N;
        targetRef.current = targetRef.current - diff * STEP;
        // Kick in the right direction so clicking a side card sweeps it forward
        velRef.current = diff > 0 ? -4 : 4;
        startSpring();
      };

      // ── Pointer helpers ───────────────────────────────────────────────────
      const getX = (e) => {
        if (e.changedTouches?.length) return e.changedTouches[0].clientX;
        if (e.touches?.length)        return e.touches[0].clientX;
        return e.clientX;
      };

      const onDown = (e) => {
        if (rafRef.current) cancelAnimationFrame(rafRef.current); // freeze animation
        const x = getX(e);
        grabXRef.current   = x;
        prevXRef.current   = x;
        grabAngle.current  = curRef.current;
        dragVelRef.current = 0;
        velRef.current     = 0;
        targetRef.current  = curRef.current; // keep target in sync while grabbed
        setGrabbing(true);
        setDidDrag(false);
      };

      const onMove = (e) => {
        if (grabXRef.current === null) return;
        const x  = getX(e);
        const dx = x - grabXRef.current;
        if (Math.abs(dx) > 8) setDidDrag(true);

        // Smoothed pixel velocity (EMA)
        dragVelRef.current = dragVelRef.current * 0.6 + (x - prevXRef.current) * 0.4;
        prevXRef.current   = x;

        // Directly drive angle — 280 px = one card step
        const newAngle        = grabAngle.current + (dx * STEP / 280);
        curRef.current        = newAngle;
        targetRef.current     = newAngle;
        setDispAngle(newAngle);
      };

      const onUp = (e) => {
        if (grabXRef.current === null) return;
        grabXRef.current = null;
        setGrabbing(false);
        // Convert pixel velocity → angular velocity, then let spring settle
        const degVel = dragVelRef.current * STEP / 280;
        snapNearest(degVel);
        setTimeout(() => setDidDrag(false), 80);
      };

      const onLeave = () => {
        if (grabXRef.current !== null) {
          grabXRef.current = null;
          setGrabbing(false);
          snapNearest(dragVelRef.current * STEP / 280);
          setTimeout(() => setDidDrag(false), 80);
        }
      };

      const ArrowBtn = ({ dir }) => {
        const [hov, setHov] = useState(false);
        return (
          <button onClick={() => go(dir)}
            onMouseEnter={() => setHov(true)} onMouseLeave={() => setHov(false)}
            style={{
              background:   hov ? "rgba(99,102,241,0.18)" : "rgba(255,255,255,0.06)",
              border:       `1px solid ${hov ? "rgba(99,102,241,0.5)" : "rgba(255,255,255,0.12)"}`,
              borderRadius: "50%", width: 44, height: 44,
              display:      "flex", alignItems: "center", justifyContent: "center",
              color: "white", cursor: "pointer", fontSize: 18,
              transition: "all 0.25s", flexShrink: 0,
            }}>{dir === -1 ? "←" : "→"}</button>
        );
      };

      // Cards sorted back → front (painter's algorithm)
      const cards = Array.from({ length: N }, (_, i) => {
        const theta  = ((i * STEP + dispAngle) * Math.PI) / 180;
        const x      = RX * Math.sin(theta);
        const z      = RZ * Math.cos(theta);
        const norm   = (z / RZ + 1) / 2;           // 0 = back, 1 = front
        const scale  = 0.60 + 0.40 * norm;
        const op     = 0.18 + 0.82 * norm;
        const tiltY  = -(Math.sin(theta) * 16);     // gentle inward lean
        return { i, x, z, scale, op, tiltY };
      }).sort((a, b) => a.z - b.z);

      return (
        <>
        <div>
          {/* ── 3D Stage ── */}
          <div
            onMouseDown={onDown}    onMouseMove={onMove}
            onMouseUp={onUp}        onMouseLeave={onLeave}
            onTouchStart={onDown}   onTouchMove={onMove}   onTouchEnd={onUp}
            className="pricing-stage"
            style={{
              position:    "relative",
              height:      "clamp(540px, 72vh, 680px)",
              perspective: "900px",
              overflow:    "hidden",
              cursor:      grabbing ? "grabbing" : "grab",
              userSelect:  "none",
            }}>

            <div style={{ position:"absolute", inset:0, display:"flex", alignItems:"center", justifyContent:"center" }}>
              {cards.map(({ i, x, z, scale, op, tiltY }) => {
                const isActive = i === active;
                return (
                  <div key={i}
                    onClick={() => { if (!didDrag && !isActive) goTo(i); }}
                    style={{
                      position:  "absolute",
                      width:     isSmall ? "clamp(200px, 72vw, 260px)" : isMobile ? "clamp(230px, 52vw, 280px)" : "clamp(262px, 24vw, 312px)",
                      // No CSS transition — RAF spring handles all motion
                      transform: `translateX(${x}px) translateZ(${z}px) scale(${scale}) rotateY(${tiltY}deg)`,
                      opacity:   op,
                      cursor:    isActive ? "default" : "pointer",
                    }}>
                    <PricingCard
                      {...plans[i]}
                      featured={isActive && plans[i].featured}
                      onGetStarted={() => setQuoteModal(plans[i].name)}
                    />
                  </div>
                );
              })}
            </div>

            {/* Side vignettes */}
            <div style={{ position:"absolute", left:0, top:0, bottom:0, width:"10%", background:"linear-gradient(to right, rgba(7,7,15,0.93), transparent)", pointerEvents:"none", zIndex:20 }} />
            <div style={{ position:"absolute", right:0, top:0, bottom:0, width:"10%", background:"linear-gradient(to left, rgba(7,7,15,0.93), transparent)", pointerEvents:"none", zIndex:20 }} />
          </div>

          {/* ── Controls ── */}
          <div style={{ display:"flex", justifyContent:"center", alignItems:"center", gap:"1.2rem", marginTop:"1.6rem" }}>
            <ArrowBtn dir={-1} />
            <div style={{ display:"flex", gap:8, alignItems:"center" }}>
              {plans.map((_, i) => (
                <button key={i} onClick={() => goTo(i)}
                  style={{
                    width:      i === active ? 24 : 8,
                    height:     8, borderRadius: 4, padding: 0,
                    background: i === active ? "linear-gradient(135deg,#6366f1,#8b5cf6)" : "rgba(255,255,255,0.2)",
                    border:     "none", cursor: "pointer",
                    transition: "all 0.35s cubic-bezier(.22,1,.36,1)",
                    boxShadow:  i === active ? "0 0 10px rgba(99,102,241,0.7)" : "none",
                  }} />
              ))}
            </div>
            <ArrowBtn dir={1} />
          </div>

          {/* Plan indicator */}
          <div style={{ textAlign:"center", marginTop:"0.85rem", fontSize:13 }}>
            <span style={{ color:T.textMuted }}>{active + 1} / {N} — </span>
            <span style={{ color:"white", fontWeight:600 }}>{plans[active].name}</span>
          </div>
        </div>

        {/* Quote request modal */}
        {quoteModal && (
          <ContactModal planName={quoteModal} onClose={() => setQuoteModal(null)} />
        )}
      </>
      );
    };

