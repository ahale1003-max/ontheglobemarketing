<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="theme-color" content="#07070f" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>On the Globe Marketing</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@1,700;1,900&family=Syne:wght@700;800&display=swap" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.development.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.development.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.2/babel.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; overflow-x: hidden; width: 100%; }
    body { background: #07070f; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden; width: 100%; position: relative; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #07070f; }
    ::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.4); border-radius: 3px; }
    @media (max-width: 768px) {
      .desktop-nav { display: none !important; }
      .mobile-menu-btn { display: flex !important; }
    }
    @media (max-width: 900px) {
      .footer-grid { grid-template-columns: 1fr 1fr !important; }
    }
    @media (max-width: 560px) {
      .footer-grid { grid-template-columns: 1fr !important; }
    }

    @keyframes logoScroll {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .logo-track { animation: logoScroll 22s linear infinite; }
    .logo-track:hover { animation-play-state: paused; }

    /* ── THREE.JS HERO ───────────────────────────────────── */
    #hero {
      position: relative;
      width: 100%;
      height: 100vh;
      min-height: 700px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    #three-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
    .hero-vignette { position: absolute; inset: 0; z-index: 2; background: radial-gradient(ellipse 80% 80% at 50% 50%, transparent 30%, rgba(7,7,26,0.6) 100%); pointer-events: none; }
    .hero-fog-bottom { position: absolute; bottom: 0; left: 0; right: 0; height: 200px; z-index: 3; background: linear-gradient(to top, #07070f, transparent); pointer-events: none; }
    .hero-content-3d {
      position: relative; z-index: 10;
      text-align: center; max-width: 820px;
      padding: 0 clamp(1rem,5vw,3rem);
      pointer-events: none;
      margin-top: -2rem;
    }
    .hero-badge-3d {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 100px;
      padding: 5px 14px 5px 8px;
      margin-bottom: 32px;
      pointer-events: all;
    }
    .hero-badge-tag-3d {
      background: linear-gradient(90deg, #6366f1, #8b5cf6);
      border-radius: 100px; padding: 2px 10px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: white;
    }
    .hero-badge-text-3d { font-size: 13px; color: rgba(240,239,255,0.7); }
    .hero-title-3d {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(52px, 8vw, 96px);
      line-height: 1.0;
      letter-spacing: -0.02em;
      color: white;
      margin-bottom: 20px;
    }
    .hero-title-3d em {
      font-style: italic;
      background: linear-gradient(90deg, #818cf8, #a78bfa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-sub-3d { font-size: 17px; line-height: 1.6; color: rgba(240,239,255,0.58); max-width: 480px; width: 100%; margin: 0 auto 36px; padding: 0 1rem; }
    .hero-ctas-3d { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; pointer-events: all; }
    .hero-btn-outline-3d {
      background: rgba(255,255,255,0.08); color: white;
      border: 1px solid rgba(255,255,255,0.2); border-radius: 100px;
      padding: 13px 28px; font-size: 15px; font-weight: 600; cursor: pointer;
      font-family: 'Inter', sans-serif; backdrop-filter: blur(6px);
      transition: background 0.2s, transform 0.15s;
    }
    .hero-btn-outline-3d:hover { background: rgba(255,255,255,0.14); transform: translateY(-2px); }
    .hero-btn-filled-3d {
      background: white; color: #0a0a14;
      border: none; border-radius: 100px;
      padding: 13px 28px; font-size: 15px; font-weight: 700; cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
      box-shadow: 0 4px 16px rgba(255,255,255,0.12);
    }
    .hero-btn-filled-3d:hover { background: #e8e8ff; transform: translateY(-2px); box-shadow: 0 8px 30px rgba(255,255,255,0.25); }

    /* ── TICKER ──────────────────────────────────────────── */
    .ticker-wrap-3d {
      position: absolute; bottom: 0; left: 0; right: 0;
      z-index: 10;
      background: rgba(7,7,26,0.55);
      border-top: 1px solid rgba(255,255,255,0.06);
      backdrop-filter: blur(12px);
      overflow: hidden; padding: 14px 0;
    }
    .ticker-label-3d { text-align: center; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.25); margin-bottom: 12px; font-weight: 600; }
    .ticker-track-3d { display: flex; animation: ticker3d 28s linear infinite; width: max-content; }
    .ticker-track-3d:hover { animation-play-state: paused; }
    @keyframes ticker3d { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .ticker-item-3d { display: flex; align-items: center; gap: 8px; padding: 0 28px; font-size: 13px; color: rgba(240,239,255,0.5); white-space: nowrap; }
    .ticker-dot-3d { width: 5px; height: 5px; border-radius: 50%; background: linear-gradient(135deg, #6366f1, #8b5cf6); flex-shrink: 0; }

    /* ── TESTIMONIAL MODAL ───────────────────────────────── */
    .modal-backdrop { position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.75); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; padding: 1rem; }
    .modal-box { background: #0f0f1f; border: 1px solid rgba(139,92,246,0.3); border-radius: 20px; padding: clamp(1.5rem,4vw,2.5rem); width: 100%; max-width: 540px; position: relative; box-shadow: 0 30px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(139,92,246,0.15); max-height: 90vh; overflow-y: auto; }
    .modal-close { position: absolute; top: 16px; right: 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: rgba(255,255,255,0.6); font-size: 18px; width: 32px; height: 32px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
    .modal-close:hover { background: rgba(255,255,255,0.12); color: white; }
    .modal-field { margin-bottom: 1.1rem; }
    .modal-label { display: block; color: rgba(255,255,255,0.6); font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px; }
    .modal-input { width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 11px 14px; color: white; font-size: 14px; font-family: 'Inter', sans-serif; outline: none; transition: border-color 0.2s; }
    .modal-input:focus { border-color: rgba(139,92,246,0.5); }
    .modal-input::placeholder { color: rgba(255,255,255,0.25); }
    .modal-textarea { resize: vertical; min-height: 110px; }
    .modal-submit { width: 100%; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; border: none; border-radius: 100px; padding: 14px; font-size: 15px; font-weight: 700; cursor: pointer; font-family: 'Inter', sans-serif; transition: opacity 0.2s, transform 0.15s; margin-top: 0.5rem; }
    .modal-submit:hover { opacity: 0.9; transform: translateY(-1px); }
    .modal-submit:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
    .star-btn { background: none; border: none; cursor: pointer; font-size: 28px; padding: 0 3px; transition: transform 0.1s; line-height: 1; }
    .star-btn:hover { transform: scale(1.2); }

    /* ═══════════════════════════════════════════════════════
       MOBILE RESPONSIVE — all breakpoints
    ═══════════════════════════════════════════════════════ */

    /* Touch target minimum */
    button, a, [role="button"] { -webkit-tap-highlight-color: transparent; }

    @media (max-width: 640px) {
      /* ── Hero ── */
      #hero { min-height: 100svh; min-height: 100vh; }
      .hero-title-3d { font-size: clamp(36px, 10vw, 52px) !important; margin-bottom: 14px; }
      .hero-sub-3d { font-size: 15px !important; margin-bottom: 28px !important; }
      .hero-ctas-3d { flex-direction: column; align-items: center; gap: 10px !important; }
      .hero-btn-outline-3d, .hero-btn-filled-3d {
        width: 100%; max-width: 300px;
        text-align: center; padding: 14px 24px !important;
      }
      .hero-badge-3d { margin-bottom: 22px; }
      .hero-content-3d { margin-top: 0 !important; }

      /* ── Ticker ── */
      .ticker-item-3d { font-size: 12px; padding: 0 18px; }

      /* ── Modals ── */
      .modal-backdrop { padding: 0.5rem; align-items: flex-end; }
      .modal-box {
        padding: 1.4rem 1.2rem 1.6rem !important;
        border-radius: 20px 20px 0 0 !important;
        max-height: 92vh;
        width: 100% !important;
        max-width: 100% !important;
      }
      .modal-submit { padding: 15px !important; font-size: 16px !important; }
      .modal-input { font-size: 16px !important; } /* prevents iOS zoom */
    }

    @media (max-width: 480px) {
      /* ── Section headings ── */
      h2 { word-break: break-word; }

      /* ── Features cards ── */
      .feature-card { padding: 1.4rem !important; }

      /* ── Quiz ── */
      .quiz-option { padding: 1rem 1.2rem !important; }

      /* ── Pricing tabs ── */
      .pricing-tabs { flex-direction: row; gap: 6px !important; }
      .pricing-tab { font-size: 13px !important; padding: 8px 14px !important; }

      /* ── Contact cards ── */
      .contact-card { padding: 1rem 1.2rem !important; }
    }

    /* ── Footer always stacks on mobile ── */
    @media (max-width: 640px) {
      .footer-grid { grid-template-columns: 1fr !important; gap: 2rem !important; }
    }

    /* ── Pricing carousel stage on mobile ── */
    @media (max-width: 700px) {
      .pricing-stage { height: clamp(480px, 85vw, 540px) !important; }
    }
    @media (max-width: 480px) {
      .pricing-stage { height: 460px !important; }
    }
  </style>
</head>
<body>
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef } = React;

    // ══════════════════════════════════════════════════════════════════════════
    // SITE CONFIG — update this ONE line before publishing
    // All contact forms, quote requests, and client reviews email here.
    const CONTACT_EMAIL = "ontheglobemarketing@gmail.com";
    // ══════════════════════════════════════════════════════════════════════════

    // ── DESIGN TOKENS ──────────────────────────────────────────────────────────
    const T = {
      bg:        "#07070f",
      bgCard:    "rgba(255,255,255,0.03)",
      bgCardHov: "rgba(255,255,255,0.06)",
      border:    "rgba(255,255,255,0.07)",
      accent1:   "#6366f1",
      accent2:   "#8b5cf6",
      accent3:   "#06b6d4",
      textSec:   "rgba(255,255,255,0.55)",
      textMuted: "rgba(255,255,255,0.3)",
      grad:      "linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #06b6d4 100%)",
      radius:    "16px",
      radiusSm:  "10px",
      font:      "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    };

    // ── HOOKS ──────────────────────────────────────────────────────────────────
    const useInView = (threshold = 0.12) => {
      const ref = useRef(null);
      const [inView, setInView] = useState(false);
      useEffect(() => {
        const obs = new IntersectionObserver(
          ([e]) => { if (e.isIntersecting) setInView(true); },
          { threshold }
        );
        if (ref.current) obs.observe(ref.current);
        return () => obs.disconnect();
      }, []);
      return [ref, inView];
    };

    const useScrollY = () => {
      const [y, setY] = useState(0);
      useEffect(() => {
        const h = () => setY(window.scrollY);
        window.addEventListener("scroll", h, { passive: true });
        return () => window.removeEventListener("scroll", h);
      }, []);
      return y;
    };

    const useWindowWidth = () => {
      const [w, setW] = useState(typeof window !== "undefined" ? window.innerWidth : 1200);
      useEffect(() => {
        const h = () => setW(window.innerWidth);
        window.addEventListener("resize", h, { passive: true });
        return () => window.removeEventListener("resize", h);
      }, []);
      return w;
    };

    // ── ANIMATED WRAPPER ───────────────────────────────────────────────────────
    const Reveal = ({ children, delay = 0, y = 36, style = {} }) => {
      const [ref, inView] = useInView();
      return (
        <div ref={ref} style={{
          opacity:   inView ? 1 : 0,
          transform: inView ? "translateY(0px)" : `translateY(${y}px)`,
          transition:`opacity 0.75s cubic-bezier(.22,1,.36,1) ${delay}s,
                     transform 0.75s cubic-bezier(.22,1,.36,1) ${delay}s`,
          ...style,
        }}>
          {children}
        </div>
      );
    };

    // ── BADGE ──────────────────────────────────────────────────────────────────
    const Badge = ({ children }) => (
      <span style={{
        display: "inline-flex", alignItems: "center", gap: 6,
        padding: "6px 14px", borderRadius: "100px",
        border: "1px solid rgba(139,92,246,0.35)",
        background: "rgba(99,102,241,0.1)",
        color: "#a5b4fc", fontSize: 12, fontWeight: 600,
        letterSpacing: "0.06em", textTransform: "uppercase",
      }}>
        <span style={{ width: 6, height: 6, borderRadius: "50%", background: T.accent2, display: "inline-block" }} />
        {children}
      </span>
    );

    // ── BUTTONS ────────────────────────────────────────────────────────────────
    const BtnPrimary = ({ children, size = "md", onClick }) => {
      const [hov, setHov] = useState(false);
      return (
        <button onClick={onClick}
          onMouseEnter={() => setHov(true)} onMouseLeave={() => setHov(false)}
          style={{
            background:    hov ? "linear-gradient(135deg,#818cf8,#a78bfa)" : T.grad,
            color: "white", border: "none",
            padding: size === "lg" ? "15px 34px" : "11px 24px",
            borderRadius: T.radiusSm,
            fontSize: size === "lg" ? 16 : 14, fontWeight: 700,
            cursor: "pointer", letterSpacing: "-0.2px",
            boxShadow: hov ? "0 8px 32px rgba(99,102,241,0.5)" : "0 4px 20px rgba(99,102,241,0.35)",
            transition: "all 0.25s ease",
            transform: hov ? "translateY(-1px)" : "none",
            whiteSpace: "nowrap",
          }}>{children}</button>
      );
    };

    const BtnGhost = ({ children, size = "md", onClick }) => {
      const [hov, setHov] = useState(false);
      return (
        <button onClick={onClick}
          onMouseEnter={() => setHov(true)} onMouseLeave={() => setHov(false)}
          style={{
            background: hov ? "rgba(255,255,255,0.08)" : "transparent",
            color: hov ? "white" : "rgba(255,255,255,0.75)",
            border: `1px solid ${hov ? "rgba(255,255,255,0.25)" : T.border}`,
            padding: size === "lg" ? "14px 32px" : "10px 22px",
            borderRadius: T.radiusSm,
            fontSize: size === "lg" ? 16 : 14, fontWeight: 600,
            cursor: "pointer", transition: "all 0.25s ease", whiteSpace: "nowrap",
          }}>{children}</button>
      );
    };

    // ── NAVBAR ─────────────────────────────────────────────────────────────────
    const NavLink = ({ href, children }) => {
      const [hov, setHov] = useState(false);
      return (
        <a href={href}
          onMouseEnter={() => setHov(true)} onMouseLeave={() => setHov(false)}
          style={{
            color: hov ? "white" : "rgba(255,255,255,0.75)",
            textDecoration: "none", fontSize: 14, fontWeight: 500,
            transition: "color 0.2s", letterSpacing: "0.01em",
          }}>{children}</a>
      );
    };

    // ── GLOBE LOGO ────────────────────────────────────────────────────────────
    const LOGO_SRC = "data:image/png;base64,";
    const AIDAN_PHOTO = "data:image/jpeg;base64,";
    const JADEN_PHOTO = "data:image/jpeg;base64,";
    const GlobeLogo = ({ size = 38 }) => (
      <img src={LOGO_SRC} alt="On the Globe Marketing" width={size} height={Math.round(size * 1.25)}
        style={{ display:"block", objectFit:"contain" }} />
    );

    const Navbar = ({ onBookCall }) => {
      const scrollY = useScrollY();
      const [menuOpen, setMenuOpen] = useState(false);
      const scrolled = scrollY > 60;
      return (
        <>
          <nav style={{
            position: "fixed", top: 0, left: 0, right: 0, zIndex: 999,
            height: "64px", display: "flex", alignItems: "center",
            padding: "0 clamp(1.2rem,4vw,2.5rem)",
            background: scrolled ? "rgba(5,5,10,0.88)" : "rgba(0,0,0,0.15)",
            backdropFilter: "blur(20px) saturate(160%)",
            borderBottom: `1px solid ${scrolled ? "rgba(255,255,255,0.07)" : "rgba(255,255,255,0.04)"}`,
            transition: "all 0.5s ease",
          }}>
            <div style={{ maxWidth: 1200, width: "100%", margin: "0 auto", display: "flex", alignItems: "center", justifyContent: "space-between" }}>
              {/* Logo */}
              <div style={{ display: "flex", alignItems: "center", gap: 10, cursor: "pointer", flexShrink: 0 }}>
                <GlobeLogo size={38} uid="nav" />
                {/* Wordmark */}
                <div style={{ lineHeight: 1 }}>
                  <div style={{ color: "white", fontWeight: 800, fontSize: 13.5, letterSpacing: "-0.3px" }}>
                    On the Globe <span style={{ background: T.grad, WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent" }}>Marketing</span>
                  </div>
                </div>
              </div>
              {/* Desktop links — centered */}
              <div style={{ display: "flex", alignItems: "center", gap: "2rem", position: "absolute", left: "50%", transform: "translateX(-50%)" }} className="desktop-nav">
                {["Work","Services","Pricing","About","Contact"].map(item => (
                  <NavLink key={item} href={`#${item.toLowerCase()}`}>{item}</NavLink>
                ))}
              </div>
              {/* Desktop CTA */}
              <div style={{ display: "flex", gap: 8, alignItems: "center" }} className="desktop-nav">
                <button style={{
                  background: "white", color: "#0a0a14", border: "none",
                  padding: "8px 18px", borderRadius: "100px",
                  fontSize: 13, fontWeight: 700, cursor: "pointer",
                  transition: "all 0.2s",
                }}
                onMouseEnter={e => { e.currentTarget.style.background = "#e8e8ff"; e.currentTarget.style.transform = "translateY(-1px)"; }}
                onMouseLeave={e => { e.currentTarget.style.background = "white"; e.currentTarget.style.transform = "none"; }}
                onClick={onBookCall}
                >Book a call</button>
              </div>
              {/* Hamburger */}
              <button onClick={() => setMenuOpen(!menuOpen)} className="mobile-menu-btn"
                style={{ background: "none", border: `1px solid rgba(255,255,255,0.15)`, borderRadius: 8, padding: "7px 10px", cursor: "pointer", color: "white", fontSize: 18, display: "none" }}>
                ☰
              </button>
            </div>
          </nav>
          {menuOpen && (
            <div style={{
              position: "fixed", top: 64, left: 0, right: 0, zIndex: 998,
              background: "rgba(5,5,10,0.97)", backdropFilter: "blur(20px)",
              borderBottom: `1px solid ${T.border}`,
              padding: "1.5rem clamp(1rem,5vw,3rem)",
              display: "flex", flexDirection: "column", gap: "1.2rem",
            }}>
              {["Work","Services","Pricing","About","Contact"].map(item => (
                <a key={item} href={`#${item.toLowerCase()}`} onClick={() => setMenuOpen(false)}
                  style={{ color: "rgba(255,255,255,0.8)", textDecoration: "none", fontSize: 18, fontWeight: 500 }}>
                  {item}
                </a>
              ))}
              <div style={{ marginTop: "0.5rem" }}><BtnPrimary size="lg" onClick={onBookCall}>Book a call</BtnPrimary></div>
            </div>
          )}
        </>
      );
    };

    // ── HERO — Three.js WebGL background ─────────────────────────────────────
    const tickerServices = ['Content Creation','Social Media Management','Video Production','Paid Media & Ads','Analytics & Reporting','Campaign Management','Influencer Strategy','Brand Strategy','SEO & Growth','Email Marketing'];

    const Hero = ({ onBookCall }) => {
      const canvasRef = useRef(null);

      useEffect(() => {
        const canvas = canvasRef.current;
        if (!canvas || typeof THREE === 'undefined') return;

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x07071a, 0.045);

        const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 80);
        camera.position.set(0, 0, 14);

        scene.add(new THREE.AmbientLight(0x6644aa, 0.6));
        const light1 = new THREE.PointLight(0x7c3aed, 4, 30);
        light1.position.set(-6, 6, 6);
        scene.add(light1);
        const light2 = new THREE.PointLight(0xa855f7, 3, 25);
        light2.position.set(8, -4, 4);
        scene.add(light2);
        const light3 = new THREE.PointLight(0x3b82f6, 2.5, 20);
        light3.position.set(0, 8, -2);
        scene.add(light3);
        const rimLight = new THREE.DirectionalLight(0x4c1d95, 1.2);
        rimLight.position.set(0, -10, -8);
        scene.add(rimLight);

        const makeMat = (hue, lightness) => {
          const color = new THREE.Color().setHSL(hue, 0.65, lightness);
          return new THREE.MeshStandardMaterial({ color, roughness: 0.2, metalness: 0.8 });
        };
        const mats = [makeMat(0.72,0.12),makeMat(0.75,0.10),makeMat(0.68,0.14),makeMat(0.80,0.11),makeMat(0.65,0.09)];

        const objects = [];
        const addTorus = (x,y,z,r,tube,mi,rx,ry,rz) => {
          const mesh = new THREE.Mesh(new THREE.TorusGeometry(r,tube,32,80), mats[mi%mats.length]);
          mesh.position.set(x,y,z); mesh.rotation.set(rx,ry,rz);
          mesh.castShadow = true; mesh.receiveShadow = true; scene.add(mesh);
          objects.push({mesh, basePos:new THREE.Vector3(x,y,z), speed:0.3+Math.random()*0.5, phase:Math.random()*Math.PI*2, spinX:(Math.random()-.5)*.003, spinY:(Math.random()-.5)*.004, floatAmp:0.3+Math.random()*0.4});
        };
        const addCylinder = (x,y,z,r,h,mi,rx,ry,rz) => {
          const mesh = new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,24), mats[mi%mats.length]);
          mesh.position.set(x,y,z); mesh.rotation.set(rx,ry,rz);
          mesh.castShadow = true; mesh.receiveShadow = true; scene.add(mesh);
          objects.push({mesh, basePos:new THREE.Vector3(x,y,z), speed:0.2+Math.random()*0.4, phase:Math.random()*Math.PI*2, spinX:(Math.random()-.5)*.002, spinY:(Math.random()-.5)*.003, floatAmp:0.25+Math.random()*0.35});
        };
        const addCapsule = (x,y,z,r,h,mi,rx,ry,rz) => {
          const group = new THREE.Group();
          const mat = mats[mi%mats.length];
          const body = new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,24), mat);
          const capT = new THREE.Mesh(new THREE.SphereGeometry(r,24,12), mat);
          const capB = new THREE.Mesh(new THREE.SphereGeometry(r,24,12), mat);
          capT.position.y = h/2; capB.position.y = -h/2;
          group.add(body,capT,capB);
          group.position.set(x,y,z); group.rotation.set(rx,ry,rz); scene.add(group);
          objects.push({mesh:group, basePos:new THREE.Vector3(x,y,z), speed:0.25+Math.random()*0.45, phase:Math.random()*Math.PI*2, spinX:(Math.random()-.5)*.003, spinY:(Math.random()-.5)*.002, floatAmp:0.2+Math.random()*0.4});
        };

        addTorus(-7,2,-2,2.4,0.55,0,0.3,0.2,0.1);
        addTorus(7,-1,-3,2.0,0.45,2,-0.2,0.4,-0.1);
        addTorus(-4,-4,-1,1.6,0.38,1,0.8,-0.3,0.5);
        addTorus(5,4,-4,2.8,0.60,3,0.1,0.6,0.2);
        addTorus(0,-6,-3,1.8,0.42,4,1.2,0.1,-0.3);
        addTorus(-9,-3,-5,2.2,0.50,0,-0.4,0.8,0.6);
        addTorus(9,5,-6,1.5,0.35,2,0.6,-0.2,0.4);
        addTorus(-5,5,-2,1.2,0.30,3,0.5,0.3,-0.2);
        addTorus(3,-5,-2,1.1,0.28,1,-0.3,0.7,0.4);
        addTorus(6,2,-1,1.0,0.25,4,0.2,-0.5,0.8);
        addCylinder(-3,3,-1,0.55,3.5,1,0.4,0.2,0.3);
        addCylinder(4,-2,-2,0.40,2.8,3,-0.3,0.6,-0.2);
        addCylinder(-6,-1,-3,0.65,4.0,0,0.6,-0.1,0.5);
        addCylinder(8,1,-4,0.45,3.2,2,0.1,0.8,0.3);
        addCylinder(1,5,-3,0.50,2.5,4,0.8,0.2,-0.4);
        addCylinder(-8,4,-5,0.60,3.8,1,0.3,0.5,0.6);
        addCapsule(-2,-3,0,0.40,1.8,2,0.5,0.3,-0.2);
        addCapsule(3,3,-1,0.35,1.5,4,-0.2,0.8,0.4);
        addCapsule(-5,0,-2,0.45,2.2,0,0.8,-0.3,0.6);
        addCapsule(6,-4,-3,0.38,1.6,3,0.1,0.5,-0.3);
        addCapsule(-1,6,-4,0.50,2.0,1,0.6,0.2,0.5);

        const pmrem = new THREE.PMREMGenerator(renderer);
        const envS = new THREE.Scene(); envS.background = new THREE.Color(0x120820);
        scene.environment = pmrem.fromScene(envS).texture;

        let mouse = {x:0,y:0}, targetMouse = {x:0,y:0};
        const onMove = e => {
          targetMouse.x = (e.clientX/window.innerWidth - 0.5)*2;
          targetMouse.y = -(e.clientY/window.innerHeight - 0.5)*2;
        };
        document.addEventListener('mousemove', onMove);

        const clock = new THREE.Clock();
        let rafId;
        const animate = () => {
          rafId = requestAnimationFrame(animate);
          const t = clock.getElapsedTime();
          mouse.x += (targetMouse.x - mouse.x)*0.04;
          mouse.y += (targetMouse.y - mouse.y)*0.04;
          camera.position.x += (mouse.x*1.2 - camera.position.x)*0.02;
          camera.position.y += (mouse.y*0.8 - camera.position.y)*0.02;
          camera.lookAt(0,0,0);
          objects.forEach(obj => {
            const {mesh,basePos,speed,phase,spinX,spinY,floatAmp} = obj;
            mesh.position.x = basePos.x + Math.sin(t*speed*0.7+phase)*floatAmp*0.5;
            mesh.position.y = basePos.y + Math.sin(t*speed+phase)*floatAmp;
            mesh.position.z = basePos.z + Math.cos(t*speed*0.6+phase)*floatAmp*0.3;
            mesh.rotation.x += spinX; mesh.rotation.y += spinY;
            const p = 1.0/(1+Math.abs(basePos.z)*0.1);
            mesh.position.x += mouse.x*p*0.8;
            mesh.position.y += mouse.y*p*0.5;
          });
          light1.position.x = -6+Math.sin(t*0.3)*2;
          light1.position.y =  6+Math.cos(t*0.4)*2;
          light2.position.x =  8+Math.cos(t*0.25)*2;
          light2.position.y = -4+Math.sin(t*0.35)*2;
          renderer.render(scene, camera);
        };
        animate();

        const onResize = () => {
          camera.aspect = window.innerWidth/window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(window.innerWidth, window.innerHeight);
        };
        window.addEventListener('resize', onResize);

        return () => {
          cancelAnimationFrame(rafId);
          document.removeEventListener('mousemove', onMove);
